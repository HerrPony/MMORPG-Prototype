; Engine configuration file.
config_version=5

[application]

config/name="Erlenwald Online"
config/description="Nativer Client für Erlenwald Online"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/version="1.0.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="ErlenwaldOnline/game"

[autoload]

S="*res://scripts/autoload/state.gd"
Net="*res://scripts/autoload/net.gd"
Settings="*res://scripts/autoload/settings.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=1024
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=1

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.07, 1)

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/narrowing_conversion=0
