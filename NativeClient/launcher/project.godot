; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Erlenwald Launcher"
config/version="1.0.6"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="ErlenwaldOnline/launcher"

[display]

window/size/viewport_width=980
window/size/viewport_height=580
window/size/resizable=false
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
